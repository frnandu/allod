[Unit]
Description=Allod kiosk (LibreWolf on the local display)
Wants=allod-setup-ui.service
After=systemd-user-sessions.service plymouth-quit-wait.service allod-data.service allod-setup-ui.service
Conflicts=getty@tty1.service
# No Condition*= here: systemd stops the conflicting getty when it queues this unit,
# even if a condition then skips it, which left tty1 black. allod-kiosk itself handles
# allod.nokiosk and machines without a display (it switches to tty2 and exits 3).

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland

# "+": as root. Puts the browser profile on the data disk when there is one.
ExecStartPre=+/usr/local/sbin/allod-kiosk-profile
ExecStart=/usr/local/bin/allod-kiosk
# Bring the screen to the kiosk (tty1) whenever it starts, e.g. after the console was shown.
ExecStartPost=+/bin/busybox chvt 1
Restart=always
RestartSec=2
RestartPreventExitStatus=3
# "+": as root (switching the console needs it; busybox has chvt). No display: show the
# status console.
ExecStopPost=+/bin/sh -c '[ "$$EXIT_STATUS" = 3 ] && busybox chvt 2 || true'

[Install]
WantedBy=multi-user.target
