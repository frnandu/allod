# Allod stack settings. Copy to .env and edit. See SPEC §2.3.
# Generate passwords with: openssl rand -hex 24

# Images
ALLOD_REGISTRY=ghcr.io/frnandu
ALLOD_VERSION=dev

# bundled -> bitcoind runs in this stack. Add https, tor, backup, postgres, electrs as needed.
COMPOSE_PROFILES=bundled

# bitcoin | signet | testnet4 | regtest
ALLOD_NETWORK=bitcoin

# bundled | bundled-rest | external-bitcoind | electrum | esplora
ALLOD_CHAIN=bundled

# --- Bitcoin Core (bundled or external-bitcoind) -------------------------------------
# Pruned by default: 50000 MiB. Minimum 5000 (about 2 weeks of blocks). 0 = unpruned.
BITCOIN_PRUNE=50000
BITCOIN_DBCACHE=450
# Hard RAM ceiling for bundled bitcoind; swap is disabled for this container.
# On a 2 GiB host, use 1g so the rest of Allod and the OS have room.
BITCOIN_MEMORY_LIMIT=2g
# During the first sync, dbcache uses up to half of available host/cgroup headroom
# (max 2 GiB) and blocksonly, then restarts with BITCOIN_DBCACHE capped to the
# same safe headroom. off disables the sync profile, but still caps dbcache.
# Settings in BITCOIN_EXTRA_CONF are not capped; the container limit still applies.
BITCOIN_SYNC_TUNING=auto
# For a faster sync on a large host, raise BITCOIN_MEMORY_LIMIT deliberately.
BITCOIN_BLOCKFILTERINDEX=1
# For external-bitcoind, point these at your node (host:port of its RPC).
BITCOIND_RPC_ADDRESS=bitcoind:8332
# Port bundled bitcoind listens on; must match BITCOIND_RPC_ADDRESS. Change both if
# another node on this host already uses 8332.
BITCOIN_RPC_PORT=8332
BITCOIND_RPC_USER=ldk
BITCOIND_RPC_PASS=change-me
# Read-only RPC user Allod uses for sync progress.
BITCOIND_RO_RPC_USER=allod-ro
BITCOIND_RO_RPC_PASS=change-me-too

# --- Light modes (no full node; less private) -------------------------------------------
# LDK_ELECTRUM_URL=ssl://your-electrum-server:50002
# LDK_ESPLORA_URL=https://your-esplora/api

# --- Lightning -------------------------------------------------------------------------------
ALLOD_ALIAS=allod
ALLOD_LIGHTNING_PORT=9735

# --- Gossip ----------------------------------------------------------------------------------
# rgs (default): ldk-server takes its graph from the local gossip sidecar (service
# `gossip`, SPEC §2.3.2 rule 5). The sidecar syncs P2P gossip (~20 s), checks every
# channel's funding output against bitcoind's UTXO set (one scantxoutset pass, works on
# a pruned node), and serves the result as Rapid Gossip Sync snapshots with capacities.
# ldk-server waits up to LDK_RGS_WAIT_SECS for the first verified graph (only a new
# stack waits noticeably), then falls back to p2p. ldk-node fetches a snapshot hourly.
# p2p: ldk-node's own gossip, checked block by block (slow on a pruned node).
#LDK_GOSSIP=rgs
# A public RGS server instead of the sidecar (then set ALLOD_GOSSIP_SIDECAR_URL= too):
#LDK_RGS_URL=https://rapidsync.lightningdevkit.org/snapshot/v2/
#LDK_RGS_WAIT_SECS=600
# Funding checks: auto (on when bitcoind answers), true, or false (unverified channels,
# no capacities; for electrum/esplora stacks without bitcoind).
#ALLOD_GOSSIP_VERIFY=auto
#ALLOD_GOSSIP_SCAN_INTERVAL_SECS=1800
# Sidecar peers are discovered: BOLT 10 DNS seeds (nodes.lightning.directory,
# nodes.lightning.wiki) on a first start, then the best-connected nodes of its own graph.
# Fixed extra peers (pubkey@host:port, comma-separated), always kept connected:
#ALLOD_GOSSIP_PEERS=
# Other DNS seeds, or "none" to disable seeding (signet/regtest have no seeds).
#ALLOD_GOSSIP_DNS_SEEDS=
#ALLOD_GOSSIP_TARGET_PEERS=6
# Status endpoint Allod shows on the node page. Set empty with LDK_GOSSIP=p2p.
#ALLOD_GOSSIP_SIDECAR_URL=http://gossip:8090/status
# Comma-separated pubkey@host:port gossip seeds connected at startup and persisted.
# They consume the five full-sync slots that p2p has, which keeps restarts converging
# even when a long-lived peer has a partial view. Gossip-only; no channel is opened.
# Empty disables seeding. The default below is ACINQ, 1ML, CoinGate, Bitfinex,
# Kraken and Block: large, long-lived clearnet nodes with complete graphs. Six
# entries cover LDK's five full-sync slots even if one is unavailable; later ones
# still receive the normal hourly updates.
#LDK_BOOTSTRAP_PEERS=03864ef025fde8fb587d989186ce6a4a186895ee44a926bfc370e2c366597a3f8f@3.33.236.230:9735,0217890e3aad8d35bc054f43acc00084b25229ecff0ab68debd82883ad65ee8266@66.109.24.41:9735,0242a4ae0c5bef18048fbecf995094b74bfb0f7391418d71ed394784373f41e4f3@3.124.63.44:9735,033d8656219478701227199cbd6f670335c8d408a92ae88b962c49d4dc0e83e025@34.65.85.39:9735,02437c00ef5de2686a6bd60f8acb5c83d17010916010a15f479d5ef84c04f04485@67.208.234.136:9735,027100442c3b79f606f80f322d98d499eefcb060599efc5d4ecb00209c2cb54190@3.226.165.222:9735

# Outbound OnionV3 peer connections use the bundled tor-proxy service by default.
# Set LDK_TOR_PROXY only when using a different SOCKS proxy.
# Public address(es) to announce, e.g. 203.0.113.7:9735
ALLOD_ANNOUNCE_ADDRESSES=
# On-chain sats kept aside per anchor channel for fee bumps. Default 0: inbound anchor
# channels work without an on-chain balance (e.g. LSP-funded channels). A low value is
# a risk: if a channel must be force-closed and the node cannot pay a higher closing
# fee, funds stay locked until you add on-chain sats. 25000 restores LDK's default.
LDK_ANCHOR_PER_CHANNEL_RESERVE_SATS=0

# --- LSPS2 LSP (just-in-time receive channels) ---------------------------------------------
# With an LSP configured, Receive can ask for a just-in-time channel: the payer's
# payment opens the inbound channel and arrives over it, so no channel is needed
# upfront. The LSP's opening fee is added to the invoice the payer pays.
# pubkey@host:port. Empty disables JIT receive (also unset for regtest).
#LDK_LSPS2_LSP=<node-pubkey>@<IP>:<PORT>
# API token the LSP issued for this node. Empty if the LSP needs none.
#LDK_LSPS2_LSP_TOKEN=
# Additionally accept 0-confirmation channels from the LSP, so JIT payments land
# without waiting for a confirmation. Trusts the LSP not to double-spend its funding.
#LDK_LSPS2_LSP_TRUST_0CONF=false

# Wait until bitcoind has fee estimates before starting ldk-server (recommended).
# bitcoind learns them from mempool/confirmed traffic, so a node synced from a
# snapshot waits hours (short targets) to weeks (the 1008-block target) before it
# answers. false starts ldk-server immediately, with the risk that force-close and
# sweep fees are mispriced until estimates exist.
LDK_WAIT_FOR_FEES=true

# --- Web UI ----------------------------------------------------------------------------------
# Node explorer linked from peers and channels ({pubkey} is replaced). Aliases themselves
# come from the node's own gossip graph, never from the explorer. Empty: no links.
#ALLOD_NODE_EXPLORER_URL=https://amboss.space/node/{pubkey}
# Keep on 127.0.0.1 and use the https profile (or an SSH tunnel / Tor) for remote access.
ALLOD_HTTP_BIND=127.0.0.1:8029
# Comma-separated Nostr relays for NWC.
ALLOD_RELAYS=wss://relay.getalby.com/v1,wss://nos.lol
# Relay URLs written into connection links, if clients reach the relays at other
# addresses than Allod does. Empty: same as ALLOD_RELAYS.
ALLOD_CLIENT_RELAYS=
# Relays to read Nostr contacts and profiles from (Send → Contacts), separate from NWC relays.
# Empty: purplepag.es, nos.lol, relay.primal.net.
ALLOD_PROFILE_RELAYS=

# --- https profile -----------------------------------------------------------------------
# ALLOD_DOMAIN=allod.example.com
# ACME_EMAIL=you@example.com
# ALLOD_PUBLIC_URL=https://allod.example.com

# --- backup profile (S3-compatible, SFTP or file URL) ------------------------------------
# LITESTREAM_REPLICA_URL=s3://bucket/allod
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# --- postgres profile --------------------------------------------------------------------
# POSTGRES_PASSWORD=
# ALLOD_DATABASE_URL=postgres://allod:${POSTGRES_PASSWORD}@postgres:5432/allod
# LDK_POSTGRES_URL=postgresql://allod:${POSTGRES_PASSWORD}@postgres:5432
