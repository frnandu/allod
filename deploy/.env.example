# Allod stack settings. Copy to .env and edit. See SPEC §2.3.
# Generate passwords with: openssl rand -hex 24

# Images
ALLOD_REGISTRY=ghcr.io/frnandu
ALLOD_VERSION=dev

# bundled -> bitcoind runs in this stack. Add https, tor, backup, postgres, electrs as needed.
COMPOSE_PROFILES=bundled

# bitcoin | signet | testnet4 | regtest
ALLOD_NETWORK=bitcoin

# bundled | bundled-rest | external-bitcoind | electrum | esplora
ALLOD_CHAIN=bundled

# --- Bitcoin Core (bundled or external-bitcoind) -------------------------------------
# Pruned by default: 50000 MiB. Minimum 5000 (about 2 weeks of blocks). 0 = unpruned.
BITCOIN_PRUNE=50000
BITCOIN_DBCACHE=450
# Hard RAM ceiling for bundled bitcoind; swap is disabled for this container.
# On a 2 GiB host, use 1g so the rest of Allod and the OS have room.
BITCOIN_MEMORY_LIMIT=2g
# During the first sync, dbcache uses up to half of available host/cgroup headroom
# (max 2 GiB) and blocksonly, then restarts with BITCOIN_DBCACHE capped to the
# same safe headroom. off disables the sync profile, but still caps dbcache.
# Settings in BITCOIN_EXTRA_CONF are not capped; the container limit still applies.
BITCOIN_SYNC_TUNING=auto
# For a faster sync on a large host, raise BITCOIN_MEMORY_LIMIT deliberately.
BITCOIN_BLOCKFILTERINDEX=1
# For external-bitcoind, point these at your node (host:port of its RPC).
BITCOIND_RPC_ADDRESS=bitcoind:8332
# Port bundled bitcoind listens on; must match BITCOIND_RPC_ADDRESS. Change both if
# another node on this host already uses 8332.
BITCOIN_RPC_PORT=8332
BITCOIND_RPC_USER=ldk
BITCOIND_RPC_PASS=change-me
# Read-only RPC user Allod uses for sync progress.
BITCOIND_RO_RPC_USER=allod-ro
BITCOIND_RO_RPC_PASS=change-me-too

# --- Light modes (no full node; less private) -------------------------------------------
# LDK_ELECTRUM_URL=ssl://your-electrum-server:50002
# LDK_ESPLORA_URL=https://your-esplora/api

# --- Lightning -------------------------------------------------------------------------------
ALLOD_ALIAS=allod
ALLOD_LIGHTNING_PORT=9735
# Outbound OnionV3 peer connections use the bundled tor-proxy service by default.
# Set LDK_TOR_PROXY only when using a different SOCKS proxy.
# Public address(es) to announce, e.g. 203.0.113.7:9735
ALLOD_ANNOUNCE_ADDRESSES=

# --- Web UI ----------------------------------------------------------------------------------
# Keep on 127.0.0.1 and use the https profile (or an SSH tunnel / Tor) for remote access.
ALLOD_HTTP_BIND=127.0.0.1:8029
# Comma-separated Nostr relays for NWC.
ALLOD_RELAYS=wss://relay.getalby.com/v1,wss://nos.lol
# Relay URLs written into connection links, if clients reach the relays at other
# addresses than Allod does. Empty: same as ALLOD_RELAYS.
ALLOD_CLIENT_RELAYS=
# Relays to read Nostr contacts and profiles from (Send → Contacts), separate from NWC relays.
# Empty: purplepag.es, relay.damus.io, nos.lol, relay.primal.net.
ALLOD_PROFILE_RELAYS=

# --- https profile -----------------------------------------------------------------------
# ALLOD_DOMAIN=allod.example.com
# ACME_EMAIL=you@example.com
# ALLOD_PUBLIC_URL=https://allod.example.com

# --- backup profile (S3-compatible, SFTP or file URL) ------------------------------------
# LITESTREAM_REPLICA_URL=s3://bucket/allod
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# --- postgres profile --------------------------------------------------------------------
# POSTGRES_PASSWORD=
# ALLOD_DATABASE_URL=postgres://allod:${POSTGRES_PASSWORD}@postgres:5432/allod
# LDK_POSTGRES_URL=postgresql://allod:${POSTGRES_PASSWORD}@postgres:5432
