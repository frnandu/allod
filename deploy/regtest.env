# Fixed, public test credentials for the regtest overlay. Never use these elsewhere.
ALLOD_NETWORK=regtest
ALLOD_CHAIN=bundled
COMPOSE_PROFILES=bundled
BITCOIND_RPC_USER=ldk
BITCOIND_RPC_PASS=ldk-regtest
BITCOIND_RO_RPC_USER=allod-ro
BITCOIND_RO_RPC_PASS=allod-ro-regtest
ALLOD_ALIAS=alice
# Own image tag and host ports, so a regtest stack never touches a real deployment on
# the same machine (which uses :dev / 8029 / 9735).
ALLOD_VERSION=regtest
# Fixed regtest owner (public test key; never use it anywhere else). The secret key is
# here so Playwright and scripts can sign in as the owner.
ALLOD_DEV_OWNER_PUBKEY=ab3916a3d120a88b9ed0b7be8c0b6596e7d6b2122f197137f447511a47b09af6
DEV_OWNER_SECRET_HEX=9a2fb0b5e2cca568a75ae871559e357aed59005cf30ff7053f01b10709c04f0a
