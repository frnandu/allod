{
	email {$ACME_EMAIL}
	# Certificates for the public name chosen in Settings (SPEC §12.1): Allod answers
	# 200 only for its current name.
	on_demand_tls {
		ask http://allod:8029/api/internal/tls-ask
	}
}

(allod) {
	@internal path /api/internal/*
	respond @internal 404
	encode zstd gzip
	reverse_proxy allod:8029
}

{$ALLOD_DOMAIN:localhost} {
	import allod
}

# Own domains (SPEC §12.1): certificates on demand; LNURL and NIP-05 reach Allod.
# The web UI and API stay on ALLOD_DOMAIN (or the local port).
https:// {
	tls {
		on_demand
	}
	# Allod's reachability check: answered here, nothing reaches Allod.
	handle /.well-known/allod-reach {
		respond "ok" 200
	}
	@identity path /.well-known/lnurlp/* /lnurlp/* /.well-known/nostr.json
	handle @identity {
		encode zstd gzip
		reverse_proxy allod:8029
	}
	handle {
		respond "Not found" 404
	}
}
